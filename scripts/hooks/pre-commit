#!/usr/bin/env bash
# Runs flutter analyze before every commit that touches app/.
# Fast (~4s) — aborts the commit if lint issues are found.
set -euo pipefail

if git diff --cached --name-only | grep -q '^app/'; then
  ROOT="$(git rev-parse --show-toplevel)"
  echo "pre-commit: flutter analyze…"
  cd "$ROOT/app"
  flutter analyze
fi
