{
  "name": "lol-companion-core",
  "version": "1.1.0",
  "description": "Node.js core backend between the Riot Live Client API and the Flutter UI app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "bundle": "webpack",
    "build:exe:windows": "npm run bundle && pkg dist/bundle.js --targets node18-win-x64 --output dist/core.exe",
    "build:exe:macos": "npm run bundle && pkg dist/bundle.js --targets node18-macos-x64 --output dist/core",
    "build:exe:linux": "npm run bundle && pkg dist/bundle.js --targets node18-linux-x64 --output dist/core",
    "docs": "typedoc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "mock-lol": "tsx src/mock-lol-server.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@google/genai": "^2.8.0",
    "dotenv": "^17.0.0",
    "openai": "^6.42.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "qs": "^6.15.2",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@yao-pkg/pkg": "^5.12.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.0",
    "typescript": "~5.8.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
